# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
build/
dist/
.cursor/

# uv / virtualenv
.venv/
venv/
# uv.lock is deliberately NOT ignored. It was, from the bootstrap commit,
# grouped here next to .venv/ as if it were a local artifact — but this is a
# deployed application, not a library, and system_release.toml calls the lock
# "ground truth for Python deps". Ignored, that was only ever true per-machine:
# a constraint change propagated but the resolved versions did not, so every
# host drifted to whatever it happened to resolve at deploy time.

# secrets — committed shape lives in .env.example
.env
.env.local
.env.*.local

# local pipeline scratch
work/
output/
out/
.cache/
samples/
bench_data/
*.layout.json

# bench datasets — large binary corpora, distributed out of band
packages/pdfsys-bench/omnidocbench_100/
packages/pdfsys-bench/olmocr_bench_50/

# models / weights (too big for git)
models/
*.onnx
*.safetensors
*.bin
*.pt

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Gradio / HF Spaces runtime artifacts
flagged/
gradio_cached_examples/
.gradio/

# bench annotation/viz — generated caches + runtime state
# (metadata.json is committed; the large previews/layout caches are regenerable
#  via pdfsys-bench/scripts/build_annotation_meta.py + build_mupdf_previews.py)
packages/pdfsys-bench/annotation/previews.json
packages/pdfsys-bench/annotation/layout_cache.json
packages/pdfsys-bench/viz/badcases.jsonl
packages/pdfsys-bench/viz/labels.jsonl

# one-time personal helper (hardcoded GH user)
push_to_github.sh
.deploy.env
